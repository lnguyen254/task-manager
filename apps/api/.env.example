# For running apps/api locally (outside Docker) against the Dockerized Postgres,
# which exposes port 5432 on localhost via docker-compose.yml.
DATABASE_URL="postgresql://taskmanager:taskmanager@localhost:5432/taskmanager?schema=public"

# Secrets used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use two DIFFERENT secrets so a leaked access token can't be replayed as a refresh token.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"
