# Consumed by docker-compose.yml. Copy to .env and adjust if needed;
# defaults below match what docker-compose.yml falls back to on its own.
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager
POSTGRES_DB=taskmanager
DATABASE_URL=postgresql://taskmanager:taskmanager@postgres:5432/taskmanager?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
